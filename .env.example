# Server Configuration
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://staging-frontend.invalid
PORT=5000
API_URL=https://staging-api.invalid

# Database (replace with your MongoDB Atlas connection string)
MONGODB_URI=your_mongodb_connection_string_here

# Authentication
JWT_SECRET=your-secure-random-string-here

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Services
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxx

# ML Service
ML_SERVICE_URL=https://staging-ml.invalid
ML_API_KEY=your-ml-api-key

# Financial APIs
ALPHA_VANTAGE_API_KEY=xxx
FINNHUB_API_KEY=xxx
POLYGON_API_KEY=xxx
FMP_API_KEY=xxx

# Crypto APIs
COINGECKO_API_KEY=xxx
COINMARKETCAP_API_KEY=xxx

# Cloud Storage
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Banking (Plaid) - Optional
PLAID_CLIENT_ID=xxx
PLAID_SECRET=xxx
PLAID_ENV=sandbox

# Kraken - Optional
KRAKEN_API_KEY=xxx
KRAKEN_PRIVATE_KEY=xxx

# Blockchain Explorer APIs (for wallet transaction syncing)
ETHERSCAN_API_KEY=xxx
BSCSCAN_API_KEY=xxx
POLYGONSCAN_API_KEY=xxx
ARBISCAN_API_KEY=xxx
OPTIMISTIC_ETHERSCAN_API_KEY=xxx
SNOWTRACE_API_KEY=xxx
BASESCAN_API_KEY=xxx
SOLSCAN_API_KEY=xxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@yourchannel

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=xxx

# Immutable Mongo user IDs permitted to run admin operations (comma separated).
# Leave empty to deny all admin operations; never put emails or Telegram IDs here.
ADMIN_USER_IDS=

# REQUIRED in production: existing persistent 32-byte key encoded as 64 hex chars.
# Preserve your existing value. Changing it prevents decryption of saved credentials.
BROKERAGE_ENCRYPTION_KEY=replace-with-your-persistent-64-hex-character-key

APP_ENV=staging
STAGING_DB_NAME=nexus_signal_staging
CLIENT_URL=https://staging-frontend.invalid
ENABLE_SCHEDULED_JOBS=false
ENABLE_NOTIFICATIONS=false
ENABLE_BILLING=false
ENABLE_BROKERAGE_SYNC=false
ENABLE_MEDIA_UPLOADS=false
STAGING_EMAIL_RECIPIENTS=
EMAIL_FROM=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=
